{
  "name": "chatgpt-tool-shim",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side pseudo-tool-calling bridge for ChatGPT web.",
  "type": "module",
  "scripts": {
    "build": "npm run build:extension && npm run build:server",
    "build:extension": "node scripts/build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server:start": "node server/dist/server.js",
    "clean": "rm -rf dist server/dist",
    "test": "vitest run",
    "debug:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/debug-bundle.ps1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.269",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
